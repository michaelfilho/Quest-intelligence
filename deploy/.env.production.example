# Copiar para deploy/.env.production NA VPS (nunca versionar).
# Host = nome do container/serviço do PostgreSQL na rede Docker compartilhada. Porta 5432 NÃO publicada.
DATABASE_URL=postgres://qi_reader:<senha>@quest-rinne-db-1:5432/quest_rinne
# Banco da aplicação (usuários, sessões, auditoria): role própria, sem acesso aos dados empresariais.
APP_DATABASE_URL=postgres://qi_app:<senha>@quest-rinne-db-1:5432/quest_rinne
# MIGRATION_DATABASE_URL (qi_migrator) fica fora do ambiente da API; usado só por npm run db:migrate.
DATABASE_NAME=quest_rinne
DATABASE_SCHEMA_CORE=core
DATABASE_SCHEMA_INGEST=ingest
DATABASE_SCHEMA_AUDIT=audit
DATABASE_POOL_MAX=5
ANALYTICS_CONCURRENCY=2
ANALYTICS_CACHE_TTL_MS=45000
ANALYTICS_CACHE_MAX_ENTRIES=256
ANALYTICS_CACHE_MAX_BYTES=16777216
ANALYTICS_QUEUE_MAX=96
ANALYTICS_QUEUE_TIMEOUT_MS=12000
SCHEMA_CACHE_TTL_MS=300000
SQL_TELEMETRY=1
APP_TIMEZONE=America/Sao_Paulo
PORT=3333
# Usado pelo docker-compose.prod.yml (interpolação):
POSTGRES_NETWORK=<rede-do-quest-rinne-db-1>
WEB_PORT=8080
PUBLIC_BASE_PATH=/core/

# --- Segurança (docs/SEGURANCA.md) ---
# Login individual: crie o 1º administrador com  npm run user:admin -- <usuario>
# Cookie de sessão só por HTTPS (false apenas em http://localhost sem TLS).
COOKIE_SECURE=true
# IPs/CIDRs sempre liberados no controle de acesso por IP (emergência), separados por vírgula.
IP_ALLOWLIST_BOOTSTRAP=
# Proxies confiáveis para X-Forwarded-For (formato "trust proxy" do Express). Dev: loopback. Produção: IP fixo do nginx (compose).
# true = recusa conexões que não venham de TRUST_PROXY (produção; definido no compose).
# Retenção da auditoria em dias.
AUDIT_RETENTION_DAYS=365
# Rede interna do RINNE (IP fixo do nginx = único proxy confiável da API). Confirme que a sub-rede está livre.
RINNE_SUBNET=172.30.57.0/29
RINNE_WEB_IP=172.30.57.2
# Quem pode informar o IP do cliente ao nginx: gateway da rede (proxy no host). Com Cloudflare, acrescente as faixas oficiais.
REAL_IP_FROM=172.30.57.1
# Camada opcional de senha única do nginx ("QUEST RINNE" para ligar, exige deploy/htpasswd).
AUTH_BASIC=off
