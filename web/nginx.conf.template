# Renderizado pelo entrypoint do nginx (envsubst): ${API_UPSTREAM}, ${AUTH_BASIC}.
# O IP real do cliente é resolvido por real_ip (conf.d/00-real-ip.conf, gerado de REAL_IP_FROM no boot):
# só proxies listados ali podem informar X-Forwarded-For. Depois disso, a API recebe UM único valor confiável.
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=site:10m rate=30r/s;

server {
    listen 80;
    server_tokens off;
    root /usr/share/nginx/html;
    client_max_body_size 64k;
    client_body_timeout 10s;
    client_header_timeout 10s;

    # 1) Allowlist de IPs: cada requisição do site é validada pela API (gerenciada em Configurações).
    auth_request /_access;
    error_page 403 /blocked.html;

    # 2) Camada opcional de senha única do nginx (padrão "off": o login individual da aplicação substitui).
    auth_basic "${AUTH_BASIC}";
    auth_basic_user_file /etc/nginx/htpasswd;

    # Atenção: add_header em um location descarta os do server — por isso o include se repete.
    include /etc/nginx/snippets/security-headers.conf;

    # Somente loopback: liveness do container, sem dados ou bypass das rotas da aplicação.
    location = /_health {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        auth_request off;
        auth_basic off;
        access_log off;
        root /usr/share/nginx/html;
        try_files /index.html =503;
    }

    location = /_access {
        internal;
        proxy_pass http://${API_UPSTREAM}/api/access/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;   # sobrescreve: nada do cliente passa adiante
    }

    location = /blocked.html {
        internal;
        auth_request off;
        auth_basic off;
    }

    # Login: limite extra contra força bruta (a API também limita por usuário e por IP).
    location = /api/auth/login {
        auth_request off;
        limit_req zone=login burst=5 nodelay;
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP "";
        proxy_set_header CF-Connecting-IP "";
    }

    # A API aplica allowlist, sessão e permissões por conta própria; não precisa da subrequisição.
    location /api/ {
        auth_request off;
        limit_req zone=api burst=40 nodelay;
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP "";
        proxy_set_header CF-Connecting-IP "";
        proxy_read_timeout 30s;
    }

    location /assets/ {
        limit_req zone=site burst=100 nodelay;
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location / {
        limit_req zone=site burst=60 nodelay;
        try_files $uri /index.html;
    }

    # Nunca servir arquivos ocultos (.env, .git etc.), caso apareçam no build.
    location ~ /\. {
        deny all;
    }
}
