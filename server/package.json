{
  "name": "quest-rinne-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "introspect": "tsx src/introspect.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=2 test/*.test.ts",
    "docs:indicators": "tsx src/docs-indicators.ts",
    "user:admin": "tsx src/cli.ts",
    "verify:analytics": "tsx src/verify-analytics.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.7",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
