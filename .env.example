# Usar SEMPRE a role somente leitura (sql/001_create_readonly_role.sql), nunca postgres.
# Dev fora da VPS: túnel SSH  ->  ssh -N -L 15432:<ip-do-container-ou-127.0.0.1>:5432 <usuario>@<vps>
#   DATABASE_URL=postgres://quest_rinne_app_ro:<senha>@127.0.0.1:15432/quest_rinne
# Na VPS, mesma rede Docker: host = quest-rinne-db-1 (ou o nome do serviço no compose)
DATABASE_URL=
# Proteção: a API só aceita postgres://.../$DATABASE_NAME e recusa o usuário postgres.
DATABASE_NAME=quest_rinne
DATABASE_POOL_MAX=10
DATABASE_SCHEMA_CORE=core
DATABASE_SCHEMA_INGEST=ingest
DATABASE_SCHEMA_AUDIT=audit
APP_TIMEZONE=America/Sao_Paulo
PORT=3333

# --- Segurança (docs/SEGURANCA.md) ---
# Login individual: crie o 1º administrador com  npm run user:admin -- <usuario>
# Cookie de sessão só por HTTPS (false apenas em http://localhost sem TLS).
COOKIE_SECURE=true
# IPs/CIDRs sempre liberados no controle de acesso por IP (emergência), separados por vírgula.
IP_ALLOWLIST_BOOTSTRAP=
# Proxies confiáveis para X-Forwarded-For (formato "trust proxy" do Express). Dev: loopback. Produção: IP fixo do nginx (compose).
TRUST_PROXY=loopback
# true = recusa conexões que não venham de TRUST_PROXY (produção; definido no compose).
REQUIRE_PROXY=false
# Retenção da auditoria em dias.
AUDIT_RETENTION_DAYS=365

# --- RINNE · integração com o n8n (TODA a IA fica no n8n; nada de chaves de provedores aqui) ---
RINNE_N8N_ENABLED=false
# Webhook do workflow da RINNE (HTTPS, ou http://<servico> na rede privada do Docker). Não usar URL de produção no dev.
RINNE_N8N_WEBHOOK_URL=
# Segredo HMAC compartilhado com o n8n (mínimo 32 caracteres; gere com: openssl rand -base64 48).
RINNE_N8N_WEBHOOK_SECRET=
RINNE_N8N_TIMEOUT_MS=60000
RINNE_N8N_MAX_CONCURRENCY=4
# URL que os agentes do n8n usam para chamar as ferramentas (ex.: http://api:3333/api/internal/tools).
RINNE_TOOLS_BASE_URL=
# Restringe a origem das chamadas internas do n8n (IPs/CIDRs separados por vírgula). Vazio = só HMAC + contexto.
RINNE_N8N_ALLOWED_IPS=
RINNE_TOOL_MAX_CALLS=50

# Origens extras aceitas na checagem CSRF (lista). Em produção normalmente vazio (vale Origin = Host).
ALLOWED_ORIGINS=
